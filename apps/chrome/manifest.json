{
  "manifest_version": 3,
  "name": "AuthBox",
  "version": "0.1.0",
  "description": "只读查看、筛选和复制 AuthBox 验证码，支持加密离线缓存。",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "alarms",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://api.example.invalid/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "index.html?popup=1",
    "default_title": "AuthBox"
  },
  "options_ui": {
    "page": "index.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; connect-src https://api.example.invalid; img-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  },
  "key": ""
}
