{
  "name": "authbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "verify:worker": "node tools/feasibility/run-worker.mjs",
    "verify:worker:static-wasm": "node tools/feasibility/run-static-wasm.mjs",
    "verify:worker:durable": "node tools/feasibility/run-durable-local.mjs",
    "verify:cloudflare:durable": "node --env-file=.env.cloudflare tools/feasibility/run-durable-cloud.mjs",
    "verify:cloudflare": "node --env-file=.env.cloudflare tools/feasibility/run-cloudflare.mjs",
    "verify:cloudflare:route": "node --env-file=.env.cloudflare tools/feasibility/run-cloudflare.mjs --route-only",
    "verify:cloudflare:domain": "node --env-file=.env.cloudflare tools/feasibility/run-cloudflare.mjs --custom-domain",
    "verify:cloudflare:domain-static-wasm": "node --env-file=.env.cloudflare tools/feasibility/run-cloudflare.mjs --custom-domain --static-wasm",
    "verify:cloudflare:domain-route": "node --env-file=.env.cloudflare tools/feasibility/run-cloudflare.mjs --custom-domain --route-only",
    "verify:cloudflare:domain-safety": "node --test tools/feasibility/domain-plan.test.mjs",
    "verify:cloudflare:preview": "node --env-file=.env.cloudflare tools/feasibility/run-cloudflare-preview.mjs",
    "verify:android": "node tools/feasibility/run-android.mjs",
    "verify:android-kdf": "node tools/feasibility/run-android-kdf.mjs",
    "verify:browser": "node tools/feasibility/run-browser.mjs",
    "verify:google": "node tools/feasibility/run-google.mjs",
    "inspect:nas": "node tools/feasibility/inspect-nas.mjs",
    "verify:nas": "node tools/feasibility/run-nas.mjs"
  },
  "devDependencies": {
    "@noble/hashes": "2.4.0",
    "esbuild": "0.28.2",
    "hash-wasm": "4.12.0",
    "jose": "6.2.12",
    "miniflare": "5.20261012.0-beta",
    "playwright-core": "1.64.1",
    "wrangler": "4.151.0",
    "ws": "8.21.0"
  }
}
